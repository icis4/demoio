    :root {
      color-scheme: light;
      font-family: Inter, system-ui, -apple-system, sans-serif;
      background-image: url('resources/background.jpg'); 
      background-size: cover;        /* Scales image to fill the screen */
      background-position: center;   /* Keeps image centered */
      background-repeat: no-repeat;  /* Prevents image tiling */
      background-attachment: fixed;  /* Keeps background still while scrolling */
      background-color: #00354B;     /* Fallback color while image loads */
      color: #E9F2FF;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 24px;
    }
    .app-shell {
      width: min(800px, 100%); background: #00354B; border-radius: 1px;
      padding: 32px; box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
      border: 1px solid #2D3742;
    }
    
    /* Global Controls */
    .header-row {
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;
      border-bottom: 1px solid #2D3742; padding-bottom: 16px;
    }
    .header-row h1 { margin: 0; font-size: 1.5rem; }
    
    button {
      border: none; border-radius: 1px; cursor: pointer; background: #65BBA9; color: white;
      font-size: 0.95rem; padding: 10px 20px; transition: 0.2s; font-weight: 600;
    }
    button:hover { background: #65BBA9; opacity: 0.6; }
    button:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-danger { background: #DB4140; } .btn-danger:hover { background: #DB4140;  }
    .btn-secondary { background: #8fc1cc; } .btn-secondary:hover { background: #8fc1cc; opacity: 0.6; }

    /* Tabs */
    .tab-bar { display: flex; gap: 8px; margin-bottom: 24px; }
    .tab-btn {
      background: transparent; color: #A9B8C9; border: 2px solid transparent; 
      border-radius: 1px; padding: 8px 16px; font-weight: 600; cursor: pointer;
    }
    .tab-btn.active { background: #132943; color: #E9F2FF; border-color: #1F3A62; }
    .tab-btn:hover:not(.active) { background: #1a273b; }
    
    .view { display: none; }
    .view.active { display: block; }

    /* --- COMPILED SCSS 3D JOYSTICK --- */
    .joystick-wrapper {
      display: flex; justify-content: center; align-items: center; 
      padding: 60px; min-height: 400px; position: relative;
    }
    .joystick {
      background: radial-gradient(at 75% 75%, #f2f2f2 0%, #d9d9d9 100%);
      box-shadow: 0 -5px 5px rgba(255, 255, 255, 0.1), 0 5px 5px rgba(255, 255, 255, 0.05), 
                  inset 0 5px 5px rgba(0, 0, 0, 0.02), inset 0 -5px 5px rgba(255, 255, 255, 0.05);
      position: relative;
      height: 200px;
      width: 200px;
      border-radius: 50%;
    }
    .joystick__ball {
      background: radial-gradient(at 25% 25%, #f2f2f2 0%, #d9d9d9 100%);
      position: absolute; height: 70%; width: 70%; border-radius: 50%;
      top: 50%; left: 50%; transform: translate(-50%, -50%);
      transform-style: preserve-3d; perspective: 1000px;
      box-shadow: inset -5px -10px 40px rgba(0, 0, 0, 0.05), inset 0px 0px 10px rgba(0, 0, 0, 0.3), 
                  inset 0px 0px 5px rgba(0, 0, 0, 0.5), inset 0px 0px 3px 1px rgba(0, 0, 0, 0.51), 
                  0px 0px 10px rgba(0, 0, 0, 0.3);
    }
    .joystick__zero {
      position: absolute; z-index: 4; height: 30%; width: 30%; border-radius: 50%;
      top: 50%; left: 50%; transform: translate(-50%, -50%);
    }
    
    /* Dynamic Stick powered by JS variables */
    .joystick__stick {
      background: radial-gradient(at 50% 75%, #f2f2f2 0%, #d9d9d9 100%);
      position: absolute; z-index: 2; height: 50%; width: 50%; border-radius: 50%;
      top: 50%; left: 50%; margin: -25% -25%;
      transition: transform 100ms ease, box-shadow 100ms ease;
      
      transform: translate(calc(var(--tx, 0) * 1%), calc(var(--ty, 0) * 1%)) 
                 rotateX(calc(var(--ty, 0) * 0.5deg)) 
                 rotateY(calc(var(--tx, 0) * -0.5deg));
                 
      box-shadow: inset calc(var(--tx, 0) * 0.25px) calc(var(--ty, 0) * 0.25px) 10px rgba(255, 255, 255, 0.3),
                  inset calc(var(--tx, 0) * -0.25px) calc(var(--ty, 0) * -0.25px) 10px rgba(0, 0, 0, 0.15),
                  0 2px 10px -5px rgba(0, 0, 0, 0.7),
                  0 4px 20px -10px rgba(0, 0, 0, 0.2),
                  calc(var(--ty, 0) * 0.5px) 0 40px -20px rgba(0, 0, 0, 0.2),
                  calc(var(--ty, 0) * -0.5px) 50px 40px -20px rgba(0, 0, 0, 0.2);
    }
    .joystick__stick:before {
      content: ''; background: #fff; position: absolute; top: 10px; left: 49px;
      width: 3px; height: 3px; border-radius: 50%;
      box-shadow: 0 2px 3px #000, 39px 40px #fff, 39px 42px 3px #000, 0px 80px #fff, 
                  0px 82px 3px #000, -39px 40px #fff, -39px 42px 3px #000;
      opacity: 0.15;
    }
    .joystick__stick:after {
      content: ''; position: absolute; top: 50%; left: 50%; width: 50%; height: 50%;
      margin: -25% -25%; border-radius: 50%;
      box-shadow: calc(var(--tx, 0) * -0.25px) calc(var(--ty, 0) * -0.25px) 20px -10px rgba(0,0,0,0.8);
      filter: blur(5px); opacity: 0.4;
    }

  /* --- NVRAM MEMORY VIEW STYLES --- */
  .mem-control-card {
    background: #00354B;
    border: 1px solid #b2c4cb;
    border-radius: 1px;
    padding: 20px;
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mem-input-group {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    flex-wrap: wrap;
  }

  .mem-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 140px;
  }

  .mem-field label {
    font-size: 0.8rem;
    color: #A9B8C9;
    text-transform: uppercase;
    font-weight: 600;
  }

  .mem-field input {
    padding: 10px;
    border-radius: 1px;
    border: 1px solid #1F3A62;
    background: #132943;
    color: #E9F2FF;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.95rem;
  }

  .mem-actions {
    display: flex;
    gap: 8px;
  }

  .mem-tools {
    display: flex;
    gap: 8px;
    border-top: 1px solid #2D3742;
    padding-top: 14px;
  }

  .mem-table-wrapper {
    background: #00354B;
    border: 1px solid #b2c4cb;
    border-radius: 1px;
    padding: 20px;
  }

  .mem-table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .mem-table-header h3 {
    margin: 0;
    font-size: 1rem;
    color: #E9F2FF;
  }

  .mem-badge {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 1px;
    background: #132943;
    color: #65BBA9;
    border: 1px solid #1F3A62;
    font-weight: 600;
  }

  .table-scroll-container {
    max-height: 380px;
    overflow-y: auto;
    border: 1px solid #2D3742;
    border-radius: 1px;
  }

  .mem-table {
    width: 100%;
    border-collapse: collapse;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 0.85rem;
    text-align: left;
  }

  .mem-table th {
    background: #132943;
    color: #A9B8C9;
    padding: 10px 14px;
    position: sticky;
    top: 0;
    z-index: 2;
    border-bottom: 1px solid #2D3742;
  }

