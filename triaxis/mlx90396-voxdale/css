    .led-active { background: #EEA320; box-shadow: 0 0 5px #EEA320; }
    .led-low-1 { background: #F2B630; box-shadow: 0 0 5px #F2B630; }
    .led-low-2 { background: #FCDA4F; box-shadow: 0 0 5px #FCDA4F; }

