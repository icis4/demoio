      position: absolute; top: -40px; left: 50%; width: 4px; height: 4px;
      border-radius: 50%; background: rgba(0, 0, 0, 0.7);
      transform-origin: 0 140px; transition: background 150ms ease, box-shadow 150ms ease;
    }
