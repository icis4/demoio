    /* --- CALIBRATION VIEW STYLES --- */
.calib-layout {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 16px;
}

.calib-card {
  background: #00354B;
  border: 1px solid #b2c4cb;
  border-radius: 1px;
  padding: 20px;
}

.calib-wizard {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.calib-wizard h3 { margin: 0 0 4px 0; font-size: 1rem; color: #E9F2FF; }

.calib-step {
  display: flex;
  gap: 12px;
  padding: 12px;
  border-radius: 1px;
  background: #132943;
  border: 1px solid #b2c4cb;
  opacity: 0.5;
  transition: opacity 0.2s, border-color 0.2s;
}

.calib-step.active {
  opacity: 1;
  border-color: #b2c4cb;
}

.step-num {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #65BBA9;
  color: #fff;
  font-weight: bold;
  font-size: 0.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-details {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
}

.step-details h4 { margin: 0; font-size: 0.85rem; color: #E9F2FF; }
.step-details p { margin: 0; font-size: 0.75rem; color: #A9B8C9; }

.calib-main {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.plot-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.plot-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.plot-header h3 { margin: 0; font-size: 0.95rem; color: #E9F2FF; }

.canvas-wrapper {
  background: #132943;
  border-radius: 1px;
  border: 1px solid #1F3A62;
  padding: 10px;
}

.telemetry-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  text-align: center;
}

.telem-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.telem-label { font-size: 0.7rem; color: #A9B8C9; text-transform: uppercase; }
.telem-val { font-family: ui-monospace, Consolas, monospace; font-size: 1rem; color: #65BBA9; font-weight: bold; }

.hidden {
  display: none !important;
}

#input-deadband {
  accent-color: #EEA320; /* Or #00ADEF for cyan */
  cursor: pointer;
}

/* --- CONNECT MODAL STYLES --- */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000;
}

.modal-card {
  background: #00354B;
  border: 1px solid #b2c4cb;
  border-radius: 4px;
  padding: 24px;
  width: min(400px, 90%);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
}

.modal-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16px; border-bottom: 1px solid #2D3742; padding-bottom: 8px;
}

.modal-header h3 { margin: 0; font-size: 1.1rem; color: #E9F2FF; }

.custom-select {
  padding: 10px;
  border-radius: 2px;
  border: 1px solid #1F3A62;
  background: #132943;
  color: #E9F2FF;
  font-size: 0.95rem;
  width: 100%;
}